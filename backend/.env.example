# Database (PostgreSQL Render)
DATABASE_URL=postgresql://appuser:PASSWORD@your-render-host.ohio-postgres.render.com/assistente_caneta?sslmode=require

# Server
NODE_ENV=production
PORT=3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-prod
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS — CSV das origens permitidas. Nunca use "*" em produção.
# Apps mobile não são afetados (não enviam header Origin).
CORS_ORIGIN=https://www.recorpo.com.br,https://recorpo.com.br

# Monitoring (Optional) — se setar, erros vão pro Sentry.
# Cadastro grátis em https://sentry.io (Developer plan, 5k eventos/mês).
# Deixe vazio pra desativar (só usa logs locais estruturados).
SENTRY_DSN=
LOG_LEVEL=info

# IA de visão (Gemini ou OpenAI)
GEMINI_API_KEY=

# Play Billing — RTDN webhook authentication.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Setar aqui E no Pub/Sub push header (x-rtdn-secret). Sem ele o webhook
# aceita qualquer POST (mitigado por re-consulta à Play API, mas não ideal).
RTDN_SHARED_SECRET=

# Stripe — pagamento Premium via site (web + iOS).
# Crie conta em https://dashboard.stripe.com, copie as chaves de API.
# STRIPE_PRICE_MONTHLY e STRIPE_PRICE_YEARLY são os Price IDs dos produtos
# criados no dashboard Stripe (ex.: price_1Qx...).
# STRIPE_WEBHOOK_SECRET vem do endpoint de webhook criado no Stripe CLI
# ou no dashboard (Developers → Webhooks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_SITE_URL=https://www.recorpo.com.br

# Email (Optional)
SENDGRID_API_KEY=
