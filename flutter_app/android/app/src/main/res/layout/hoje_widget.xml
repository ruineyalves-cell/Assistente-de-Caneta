<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget "Recorpo Hoje" (Bloco 1) — 4x2:

    ┌───────────────────────────────────────────┐
    │  ( anéis )   Score 78%                     │
    │  ( +Score )  Proteína · 96 / 140 g         │
    │              Água · 48% · 1,4 L            │
    │              🔥 12 dias                     │
    │  [   +250 ml   ] [   +500 ml   ]           │
    └───────────────────────────────────────────┘

    Área de resumo (hoje_info) abre o app; os botões incrementam água em
    background (mesmo fluxo seguro do widget de Água). Só dados NÃO
    sensíveis — peso/sintomas nunca aparecem.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hoje_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_hoje_bg">

    <!-- Resumo (toque abre o app) -->
    <LinearLayout
        android:id="@+id/hoje_info"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/hoje_rings"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/hoje_widget_desc"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hoje_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recorpo"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#EAF0F8"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/hoje_prot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="#B9C6DC"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/hoje_agua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="#B9C6DC"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/hoje_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="#E9A03C"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Atalhos de água -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/hoje_btn_250"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_agua_btn_bg"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+250 ml"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hoje_btn_500"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_agua_btn_bg"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+500 ml"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
